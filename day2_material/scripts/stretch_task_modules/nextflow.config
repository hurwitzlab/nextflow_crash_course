// nextflow.config
params {
    input  = 'data/sample_*_*.fastq'
    outdir = 'results'
}

profiles {
    hazel {

        // Processing configuration
        process.executor = 'slurm'
        process.cpus      = 2
        process.memory    = 4.GB
        process.time      = 1.h
        process.beforeScript = 'module load singularity'

        process.resourceLimits = [
            memory: 128.GB,
            cpus:   24,
            time:   120.h
        ]
       
        
        singularity {
            enabled    = true
            autoMounts = true
            cacheDir   = System.getenv('APPTAINER_CACHEDIR') ?: "/share/${System.getenv('GROUP')}/${System.getenv('USER')}/tmp"

            // autoMounts doesn't bind Hazel's system $TMPDIR, breaking tools that use it
            runOptions = '-B ${TMPDIR:-/tmp}'
        }


    }
    
    

}