// nextflow.config
params {
    input  = '/gpfs_backup/bioinfo_data/training_data/nextflow_crash_course/sample_*_*.fastq.gz'
    outdir = 'results'
}

profiles {
    hazel {
        process.executor     = 'slurm'
        process.cpus         = 2
        process.memory       = 4.GB
        process.time         = 1.h
        process.beforeScript = 'module load apptainer'

        process.resourceLimits = [
            memory: 128.GB,
            cpus:   24,
            time:   120.h
        ]

        // §5.5's example config names this block `assembly` — a stand-in name
        // used before megahit existed in the doc. The real process here is
        // `megahit`, so that's what withName has to match to actually apply.
        // multiqc is lightweight and just falls back to the profile default.
        process {
            withName: 'fastqc' {
                cpus   = 1
                memory = 2.GB
            }
            withName: 'megahit' {
                cpus   = 8
                memory = 32.GB
                time   = 2.h
            }
        }

        apptainer {
            enabled    = true
            autoMounts = true
            cacheDir   = System.getenv('APPTAINER_CACHEDIR') ?: "/share/${System.getenv('GROUP')}/${System.getenv('USER')}/tmp"

            // autoMounts doesn't bind Hazel's system $TMPDIR, breaking tools that use it
            runOptions = '--bind /rs1:/rs1 --bind ${TMPDIR:-/tmp}'
        }
    }

    local {
        process.executor = 'local'
    }
}
